{
  "name": "tzcg-react",
  "version": "0.1.0",
  "description": "Offline React Time Zone Calculator & Grid",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "outputs/DADOS.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --clean && node scripts/copy-css.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm run check:package",
    "check": "npm run typecheck && npm test && npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "react",
    "typescript",
    "timezone",
    "iana",
    "world-clock",
    "offline",
    "travel",
    "time-zone-grid"
  ],
  "author": "Marcos Araujo",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmarjo/TZCG.git"
  },
  "homepage": "https://github.com/devmarjo/TZCG#readme",
  "bugs": {
    "url": "https://github.com/devmarjo/TZCG/issues"
  }
}
